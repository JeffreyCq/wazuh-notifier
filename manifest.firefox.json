{
  "manifest_version": 3,
  "name": "Wazuh Notifier",
  "version": "1.0.0",
  "description": "Real-time critical alert notifications from your Wazuh cluster",
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Wazuh Notifier"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wazuh-notifier@extension",
      "strict_min_version": "109.0"
    }
  }
}
